# ============================================================================
#  Исправление батареи для 12S
#  Применять ТОЛЬКО если батарея реально 12S (полный заряд ~50.4V)
# ============================================================================

# Voltage multiplier: удвоен (47.564 × 2) т.к. показывал вдвое меньше
BATT_VOLT_MULT,95.128

# Количество ячеек для OSD: 12 вместо 6
OSD_CELL_COUNT,12
