# ============================================================
# ИСПРАВЛЕНИЕ ПАРАМЕТРОВ: Cube Orange + ELRS + Walksnail
# Прошивка: ArduPilot Copter
# Проблема: OSD не показывает реальные RSSI и LQ
# ============================================================
#
# КАК ПРИМЕНИТЬ:
#   Mission Planner → Config → Full Parameter List
#   → Load from file → выбрать этот файл
#   → Write Params → перезагрузить автопилот
#
# МЕНЯТЬ НУЖНО ТОЛЬКО ЭТИ 2 ПАРАМЕТРА:
#

# --- ИСПРАВЛЕНИЕ 1: ИСТОЧНИК RSSI (КРИТИЧНО) ---
# Было: RSSI_TYPE=2 → ArduPilot брал RSSI из RC-канала (PWM)
# ELRS НЕ передаёт RSSI через RC-каналы!
# ELRS передаёт RSSI и LQ через CRSF Link Statistics.
# Стало: RSSI_TYPE=3 → ReceiverProtocol (берёт данные из CRSF)
RSSI_TYPE,3

# --- ИСПРАВЛЕНИЕ 2: КАНАЛ RSSI (КРИТИЧНО) ---
# Было: RSSI_CHANNEL=15 → указывало на RC-канал 15 (бессмысленно для ELRS)
# Стало: RSSI_CHANNEL=0 → не используется (RSSI идёт из протокола)
RSSI_CHANNEL,0

# ============================================================
# ПАРАМЕТРЫ, КОТОРЫЕ УЖЕ НАСТРОЕНЫ ПРАВИЛЬНО — НЕ МЕНЯТЬ:
# ============================================================
#
# SERIAL4_PROTOCOL = 23   ✅ CRSF (RCIN) для ELRS
# SERIAL4_BAUD     = 115  ✅ RC_OPTIONS бит 13 (8192) включает 420K baud автоматически
# RC_OPTIONS       = 8708 ✅ бит 2 (failsafe) + бит 9 (suppress CRSF msg) + бит 13 (420K baud)
# RC_PROTOCOLS     = 512  ✅ CRSF протокол
# RC_SPEED         = 490  ✅ частота ШИМ на ESC (не связана с ELRS)
# OSD_TYPE         = 5    ✅ MSP DisplayPort (для Walksnail)
# SERIAL2_PROTOCOL = 42   ✅ MSP DisplayPort для Walksnail
# SERIAL2_BAUD     = 115  ✅ 115200 для MSP
# OSD1_RSSI_EN     = 1    ✅ элемент RSSI на OSD включён
# OSD1_LINK_Q_EN   = 1    ✅ элемент LQ на OSD включён
# TELEM_DELAY      = 0    ✅ телеметрия без задержки
#
# ============================================================
# ЧТО НЕ НУЖНО МЕНЯТЬ (частые ошибки в советах):
# ============================================================
#
# SERIAL4_BAUD = 420  ← НЕВЕРНО: 115 правильно (бит 13 включает 420K)
# RC_SPEED     = 0    ← НЕВЕРНО: 490 правильно (это ESC PWM, не ELRS)
# RC_OPTIONS   = 768  ← НЕВЕРНО: 8708 правильно
# SCHED_LOOP_RATE = 800 ← НЕ РЕКОМЕНДУЕТСЯ: может перегрузить CPU
#
# ============================================================
# ДОПОЛНИТЕЛЬНО: настройка ELRS RX приёмника
# ============================================================
#
# В ELRS Web UI (WiFi точка доступа приёмника):
#   UART Baud → 420000  (если сейчас стоит 460800 — изменить обязательно)
#
# Разница 460800 vs 420000 = ~9.7% → выходит за пределы UART толерантности
# Это вызывает: нестабильный RSSI, скачки LQ, потерю пакетов
#
# ============================================================
# НАСТРОЙКИ ELRS TX МОДУЛЯ (Lua Script на аппаратуре):
# ============================================================
#
#   Packet Rate     = 150 Hz    (задержка ~16 мс, оптимум 20-50 км)
#   Telemetry Ratio = 1:32      (минимальное влияние на задержку стиков)
#   Switch Mode     = Hybrid    (оптимально для автопилотов)
#   RF Mode         = Dynamic   (авто для максимальной дальности)
#   Model Match     = OFF       (предотвращает проблемы с failsafe)
#   Dynamic Power   = ON        (авто-регулировка мощности)
